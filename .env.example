APP_NAME=proweb.az
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://proweb.loc

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gopanel
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Ümumi qat (bax: docs/shared-layer.md) ---

# Statik/yüklənmiş fayllar üçün CDN kökü. Boş qalsa APP_URL işlədilir.
# DİQQƏT: CDN qoşulanda config/filesystems.php → disks.public.url da uzlaşdırılmalıdır.
CDN_URL=

# TTL göndərilmədən çağırılan CacheService metodlarının ömrü (saniyə)
CACHE_DEFAULT_TTL=3600

# Mail brendi - email şablonlarının başlıq/altlığı (config/custom/mail.php)
MAIL_BRAND_TITLE="${APP_NAME}"
MAIL_BRAND_FOOTER_TITLE=
MAIL_BRAND_DESCRIPTION=
MAIL_BRAND_LOGO_HEADER=
MAIL_BRAND_LOGO_FOOTER=
MAIL_BRAND_INFO_EMAIL=
MAIL_BRAND_PHONE=
MAIL_BRAND_ADDRESS=
MAIL_QUEUE=email_queue
MAIL_QUEUE_CONNECTION=

# SMS (config/custom/sms.php)
# Default LogProvider heç nə göndərmir, yalnız storage/logs/sms/ faylına yazır.
# Canlıda: SMS_PROVIDER="App\Services\Sms\Providers\Lsim"
SMS_PROVIDER=
SMS_ENABLED=true
SMS_TIMEOUT=15
LSIM_LOGIN=
LSIM_PASSWORD=
LSIM_URL=https://www.sendsms.az/smxml/api
LSIM_TITLE="${APP_NAME}"

# Export (config/custom/export.php)
EXPORT_SYNC_LIMIT=300
EXPORT_DISK=local
EXPORT_RETENTION_DAYS=7
EXPORT_BRAND_TITLE="${APP_NAME}"
EXPORT_BRAND_PHONE=
EXPORT_BRAND_WEBSITE=
EXPORT_BRAND_LOGO=

# Təhlükəsizlik (config/custom/security.php)
IP_RESTRICTION_ENABLED=false
ALLOWED_IPS=
RESTRICTED_DOMAINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=10
UPLOAD_MAX_SIZE_KB=5120
