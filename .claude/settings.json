{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "//": "QAYDA: oxumaq, yazmaq, redaktə etmək, artisan/composer/npm/git işlətmək - SORUŞULMUR. YALNIZ geri qaytarılmayan əməliyyatlar (silmə, force push, bazanı uçurmaq, deploy) soruşulur. Bu fayl repoda qalır (paylaşılan). Şəxsi override üçün .claude/settings.local.json işlədilir - o, gitignore-dadır.",

  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [],

    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(find:* -delete)",
      "Bash(find:* -exec rm:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git branch -D:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan queue:flush:*)",
      "Bash(php artisan backup:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Remove-ItemProperty:*)",
      "PowerShell(rm:*)",
      "PowerShell(ri:*)",
      "PowerShell(del:*)",
      "PowerShell(erase:*)",
      "PowerShell(rmdir:*)",
      "PowerShell(Clear-Content:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git push:*)",
      "PowerShell(php artisan migrate:fresh:*)",
      "PowerShell(php artisan migrate:reset:*)",
      "PowerShell(php artisan migrate:rollback:*)",
      "PowerShell(php artisan db:wipe:*)"
    ],

    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Read(//c/OpenServer/domains/judo/**)",
      "Read(//c/OpenServer/domains/qrgate/**)",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Skill",
      "WebFetch",
      "WebSearch",
      "TodoWrite"
    ],

    "additionalDirectories": [
      "C:\\OpenServer\\domains\\judo"
    ]
  }
}
