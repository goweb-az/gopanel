APP_NAME=proweb.az
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://proweb.loc

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gopanel
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Ümumi qat (bax: docs/shared-layer.md) ---

# Statik/yüklənmiş fayllar üçün CDN kökü. Boş qalsa APP_URL işlədilir.
# DİQQƏT: CDN qoşulanda config/filesystems.php → disks.public.url da uzlaşdırılmalıdır.
CDN_URL=

# Panelin öz domeni (canlıda https://go.example.dev). Boş qalsa panel hər host-da açılır.
GOPANEL_URL=

# Ayrıca ictimai sayt (headless frontend) ünvanı - App\Support\Url\FrontendUrl.
# Boş qalsa APP_URL-in "api." prefiksi atılır (https://api.site.az → https://site.az).
FRONTEND_URL=

# Qeyd təyinatı: neçə saatdan sonra "köhnəlmiş" sayılır (config/gopanel/assignment.php). 0 = heç vaxt.
GOPANEL_ASSIGNMENT_TTL_HOURS=8

# Statik xəritə şəkli (config/custom/map.php): none | google | geoapify
STATIC_MAP_PROVIDER=none
STATIC_MAP_KEY=

# API siyahılarında səhifə ölçüsü (config/api.php)
API_PER_PAGE=20
API_MAX_PER_PAGE=100

# TTL göndərilmədən çağırılan CacheService metodlarının ömrü (saniyə)
CACHE_DEFAULT_TTL=3600

# Mail brendi - email şablonlarının başlıq/altlığı (config/custom/mail.php)
MAIL_BRAND_TITLE="${APP_NAME}"
MAIL_BRAND_FOOTER_TITLE=
MAIL_BRAND_DESCRIPTION=
MAIL_BRAND_LOGO_HEADER=
MAIL_BRAND_LOGO_FOOTER=
MAIL_BRAND_INFO_EMAIL=
MAIL_BRAND_PHONE=
MAIL_BRAND_ADDRESS=
MAIL_QUEUE=email_queue
MAIL_QUEUE_CONNECTION=

# SMS (config/custom/sms.php)
# Default LogProvider heç nə göndərmir, yalnız storage/logs/sms/ faylına yazır.
# Canlıda: SMS_PROVIDER="App\Services\Sms\Providers\Lsim"
SMS_PROVIDER=
SMS_ENABLED=true
SMS_TIMEOUT=15
LSIM_LOGIN=
LSIM_PASSWORD=
LSIM_URL=https://www.sendsms.az/smxml/api
LSIM_TITLE="${APP_NAME}"

# Export (config/custom/export.php)
EXPORT_SYNC_LIMIT=300
EXPORT_DISK=local
EXPORT_RETENTION_DAYS=7
EXPORT_BRAND_TITLE="${APP_NAME}"
EXPORT_BRAND_PHONE=
EXPORT_BRAND_WEBSITE=
EXPORT_BRAND_LOGO=
EXPORT_COLOR_ACCENT=2A5C9A
EXPORT_COLOR_HEADER=2A5C9A
EXPORT_MAX_ROWS=20000
# PDF üçün: composer require barryvdh/laravel-dompdf
EXPORT_PDF_PAPER=a4
EXPORT_MAIL_QUEUE_CONNECTION=
EXPORT_MAIL_QUEUE=

# Təhlükəsizlik (config/custom/security.php)
IP_RESTRICTION_ENABLED=false
ALLOWED_IPS=
RESTRICTED_DOMAINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=10
UPLOAD_MAX_SIZE_KB=5120
# Yalnız server Cloudflare arxasındadırsa true (əks halda başlıq saxtalaşdırıla bilər)
SECURITY_TRUST_CF_HEADER=false

# Admin PIN-i - həssas əməliyyatların ikinci təsdiqi (docs/security-and-auth.md)
ADMIN_PIN_ENABLED=false
ADMIN_PIN_MIN=4
ADMIN_PIN_MAX=6
ADMIN_PIN_TTL=15
ADMIN_PIN_ATTEMPTS=5
ADMIN_PIN_DECAY=5

# Birdəfəlik e-poçt kodu (App\Services\Auth\OtpService)
OTP_TTL=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_LOG_CHANNEL=gopanel-auth

# Sayt bağlı olanda (site_status=0) 503 + Retry-After; false → köhnə layout davranışı
SITE_STATUS_ENFORCE=false
SITE_STATUS_RETRY_AFTER=3600
SITE_STATUS_EXCEPT=robots.txt,llms.txt,ads.txt

# Dev domen qoruyucusu (qlobal middleware)
DEV_GUARD_ENABLED=false
DEV_GUARD_DOMAINS=
DEV_GUARD_ALLOWED_IPS=
DEV_GUARD_UNLOCK_KEY=
DEV_GUARD_REDIRECT_TO=
DEV_GUARD_REDIRECT_STATUS=302
DEV_GUARD_KEEP_PATH=true

# Performans diaqnostikası (config/custom/performance.php) - APP_DEBUG=true da lazımdır
SERVER_TIMING_ENABLED=false
SERVER_TIMING_SLOW_MS=0

# Backup (config/gopanel/backup.php)
# mysqldump binary-si SERVERDƏKİ baza ilə eyni ailədən olmalıdır:
# MariaDB serverə MySQL 8-in mysqldump-ı «Unknown table 'column_statistics'» verir.
# Windows/OpenServer nümunəsi:
# BACKUP_MYSQLDUMP_BINARY="C:/OpenServer/modules/database/MariaDB-10.3/bin/mysqldump.exe"
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MIN_FREE_SPACE=2147483648
BACKUP_JOB_TIMEOUT=3600

# Sistem vəziyyəti (config/gopanel/system_status.php)
SYSTEM_STATUS_REFRESH_MS=5000
SYSTEM_STATUS_SHOW_CRONTAB=true
